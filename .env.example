# Copier ce fichier en « .env » et remplacer chaque valeur. Ne jamais committer « .env ».

# Adresse publique de l'application (https en production).
URL_APP=http://localhost:3000

# Connexions à PostgreSQL : un rôle par usage. Mots de passe différents en production.
DATABASE_URL_SUPER=postgres://postgres:postgres@127.0.0.1:5432/postgres
DATABASE_URL_PROPRIETAIRE=postgres://hanout_proprietaire:changer1@127.0.0.1:5432/hanout
DATABASE_URL_APP=postgres://hanout_app:changer2@127.0.0.1:5432/hanout
DATABASE_URL_AUTH=postgres://hanout_auth:changer3@127.0.0.1:5432/hanout
DATABASE_URL_PLATEFORME=postgres://hanout_plateforme:changer4@127.0.0.1:5432/hanout
# « require » en production : la connexion à la base passe par TLS.
DATABASE_SSL=off

# Clés de chiffrement champ par champ (AES-256-GCM) : « numéro:clé en base64 », séparées par des virgules.
# Créer une clé : openssl rand -base64 32
# Pour renouveler : ajouter une clé avec un nouveau numéro et changer CLE_CHIFFREMENT_ACTIVE.
CLES_CHIFFREMENT=1:REMPLACER_PAR_UNE_CLE_BASE64_DE_32_OCTETS
CLE_CHIFFREMENT_ACTIVE=1
# Clé des empreintes de recherche (HMAC). Créer : openssl rand -base64 32
CLE_HMAC=REMPLACER_PAR_UNE_AUTRE_CLE_BASE64

# Dossier des fichiers envoyés (photos des produits). À sauvegarder avec la base.
DOSSIER_FICHIERS=./donnees

# Chromium, pour produire les PDF. À définir seulement s'il n'est pas trouvé tout seul.
# CHEMIN_CHROMIUM=/usr/bin/chromium
